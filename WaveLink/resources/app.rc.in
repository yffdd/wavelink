IDI_ICON1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/resources/app.ico"

1 VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@WAVELINK_VERSION_PATCH_VALUE@,@WAVELINK_VERSION_TWEAK_VALUE@
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@WAVELINK_VERSION_PATCH_VALUE@,@WAVELINK_VERSION_TWEAK_VALUE@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404B0"
        BEGIN
            VALUE "CompanyName", "xiales\0"
            VALUE "FileDescription", "WaveLink Signal Acquisition and Analysis\0"
            VALUE "FileVersion", "@PROJECT_VERSION@\0"
            VALUE "InternalName", "WaveLink\0"
            VALUE "OriginalFilename", "WaveLink.exe\0"
            VALUE "ProductName", "WaveLink\0"
            VALUE "ProductVersion", "@PROJECT_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
